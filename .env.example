# Copy to .env for local work. On Replit set these as Secrets instead.
# Replit provides DATABASE_URL automatically for the PostgreSQL database.
# The plain postgresql:// and postgres:// forms are both accepted, the driver is
# switched to psycopg automatically.
#
# The port and database name must match a cluster that really exists on your
# machine. The values below match the development cluster described in SETUP.md.
# Check yours with:  pg_isready -h 127.0.0.1 -p 5433
#                   psql -h 127.0.0.1 -p 5433 -U postgres -l
#
# A bare `cp .env.example .env` overwrites a working .env. Use `cp -n`.
#
# Example of the generic form:
#   DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/agura_dev
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/agura_test

JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=agura
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

ADMIN_BOOTSTRAP_EMAIL=admin@agura.rw
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=AGUra Administrator

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SMS_ENABLED=false
SMS_PROVIDER=console
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=AGUra

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info

# Privacy: aggregates built from fewer households than this are suppressed everywhere.
SMALL_CELL_THRESHOLD=10

# Feature flags
PHONE_VERIFICATION_ENABLED=false

# Rate limits (per window, per identity)
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
